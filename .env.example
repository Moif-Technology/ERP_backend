PORT=5010
DATABASE_URL=postgresql://user:password@localhost:5432/moifone_erp
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Comma-separated browser origins (Moifone Next + ERP Vite)
CORS_ORIGINS=http://localhost:3000,http://localhost:5011,http://localhost:5173

# --- Scaling / production (all optional; sane defaults when unset) ---
NODE_ENV=development
LOG_LEVEL=info
# DB connection pool size PER process. With PgBouncer/RDS Proxy keep this low.
PG_POOL_MAX=20
PG_POOL_MIN=2
# Optional read replica for heavy/list reads (falls back to primary when unset).
DATABASE_REPLICA_URL=
# Optional Redis for session cache + shared rate limiting (e.g. AWS ElastiCache).
REDIS_URL=
# Number of proxy hops to trust (1 behind a single LB/Nginx; 0 to disable).
TRUST_PROXY=0
# Rate limits (requests/min per client IP). High default avoids blocking
# offices behind one NAT IP. Lower only if you see abuse.
RATE_LIMIT_API_PER_MIN=2000
RATE_LIMIT_AUTH_PER_MIN=30

# --- Email (Resend) ---
# Get API key from resend.com. Add moifone.com domain there + copy DNS records to Hostinger.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@moifone.com
# Frontend URL used in email links (no trailing slash)
FRONTEND_URL=https://moifone.com
